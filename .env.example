# Application Port
PORT=3000

# Node Environment (development | production | test)
NODE_ENV=development

# Database path (optional, defaults to database.sqlite in root)
DB_PATH=./database.sqlite

# AWS Configuration (Used by Harness connectors)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY_NAME=express-harness-demo

# Sonar Configuration (Used by Harness secrets)
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=your-sonar-token
SONAR_PROJECT_KEY=express-harness-demo

# Synopsys Black Duck Configuration (Used by Harness secrets)
BLACKDUCK_URL=https://yourcompany.app.blackduck.com
BLACKDUCK_API_TOKEN=your-blackduck-api-token
